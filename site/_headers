# Security headers Cloudflare sends with every page and file.
# The Content-Security-Policy only lets pages run scripts, styles, fonts and images from this
# site, makes no network requests at all (connect-src 'none'), and blocks inline scripts and
# styles and framing by other sites. That stops injected markup from running code or quietly
# sending report data to another server. It does not cover a script navigating the page away,
# which is why everything read from a PDF is also escaped before it is shown.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; worker-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# The pages are never cached, but Cloudflare's default lets browsers keep scripts and styles
# for four hours. A deploy that changes a page and its script together would then run the new
# page with the old script, so the site's own files must be revalidated on every load. The
# third-party code and fonts in vendor/ change rarely and keep the default.
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/lib/*
  Cache-Control: public, max-age=0, must-revalidate
